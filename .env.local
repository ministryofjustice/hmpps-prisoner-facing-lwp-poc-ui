# Example .env file for local development. Copy contents into .env file to run locally.
# Do not commit secrets to source control!

# Retrieve secrets from kubernetes and populate these environment variables
AUTH_CODE_CLIENT_ID=XXXX
AUTH_CODE_CLIENT_SECRET=XXXX
LAUNCHPAD_AUTH_CODE_CLIENT_ID=XXXX
LAUNCHPAD_AUTH_CODE_CLIENT_SECRET=XXXX
CLIENT_CREDS_CLIENT_ID=XXXX
CLIENT_CREDS_CLIENT_SECRET=XXXX

NODE_ENV=development
REDIS_ENABLED=false
TOKEN_VERIFICATION_ENABLED=true

HMPPS_AUTH_URL=https://sign-in-dev.hmpps.service.justice.gov.uk/auth
TOKEN_VERIFICATION_API_URL=https://token-verification-api-dev.prison.service.justice.gov.uk
LAUNCHPAD_AUTH_URL=https://launchpad-auth-dev.hmpps.service.justice.gov.uk
